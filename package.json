{
  "name": "boiskopro-shop",
  "version": "1.0.0",
  "description": "BoiskoPro — sklep piłkarski z PostgreSQL i MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build:api && npm run build:client",
    "build:api": "tsc",
    "build:client": "npm run build --prefix client",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/index.ts",
    "seed:reset": "tsx src/seed/index.ts --reset",
    "db:init": "tsx src/db/initSchema.ts",
    "db:install": "powershell -ExecutionPolicy Bypass -File scripts/install-databases.ps1"
  },
  "keywords": [
    "shop",
    "postgresql",
    "mongodb",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.3",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
